class Module:
    @T.prim_func(s_tir=True)
    def main(X: T.Buffer((1, 8, 2048, 2048), "float16"), W: T.Buffer((8, 1, 7, 7), "float16"), DepthwiseConv2d: T.Buffer((1, 8, 2048, 2048), "float16")):
        T.func_attr({"tirx.noalias": True})
        # with T.sblock("root"):
        PaddedInput = T.sblock_alloc_buffer((1, 8, 2054, 2054), "float16")
        for i0, i1, i2, i3 in T.grid(1, 8, 2054, 2054):
            with T.sblock("PaddedInput"):
                v_i0, v_i1, v_i2, v_i3 = T.axis.remap("SSSS", [i0, i1, i2, i3])
                T.reads(X[v_i0, v_i1, v_i2 - 3, v_i3 - 3])
                T.writes(PaddedInput[v_i0, v_i1, v_i2, v_i3])
