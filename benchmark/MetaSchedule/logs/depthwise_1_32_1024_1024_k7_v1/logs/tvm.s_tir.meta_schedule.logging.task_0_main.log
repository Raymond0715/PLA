@I.ir_module
class Module:
    @T.prim_func(s_tir=True)
    def main(X: T.Buffer((1, 32, 1024, 1024), "float16"), W: T.Buffer((32, 1, 7, 7), "float16"), DepthwiseConv2d: T.Buffer((1, 32, 1024, 1024), "float16")):
        T.func_attr({"tirx.noalias": True})
        # with T.sblock("root"):
        PaddedInput = T.sblock_alloc_buffer((1, 32, 1030, 1030), "float16")
        for i0, i1, i2, i3 in T.grid(1, 32, 1030, 1030):
            with T.sblock("PaddedInput"):
                v_i0, v_i1, v_i2, v_i3 = T.axis.remap("SSSS", [i0, i1, i2, i3])
                T.reads(X[v_i0, v_i1, v_i2 - 3, v_i3 - 3])
                T.writes(PaddedInput[v_i0, v_i1, v_i2, v_i3])
                PaddedInput[v_i0, v_i1, v_i2, v_i3] = T.if_then_else(3 <= v_i2 and v_i2 < 1027 and 3 <= v_i3 and v_i3 < 1027, X[v_i0, v_i1, v_i2 - 3, v_i3 - 3], T.float16(0.0))
        for b, c, i, j, di, dj in T.grid(1, 32, 1024, 1024, 7, 7):
            with T.sblock("DepthwiseConv2d"):
                v_b, v_c, v_i, v_j, v_di, v_dj = T.axis.remap("SSSSRR", [b, c, i, j, di, dj])
                T.reads(PaddedInput[v_b, v_c, v_i + v_di, v_j + v_dj], W[v_c, 0, v_di, v_dj])
                T.writes(DepthwiseConv2d[v_b, v_c, v_i, v_j])
                with T.init():
                    DepthwiseConv2d[v_b, v_c, v_i, v_j] = T.float16(0.0)
                DepthwiseConv2d[v_b, v_c, v_i, v_j] = DepthwiseConv2d[v_b, v_c, v_i, v_j] + PaddedInput[v_b, v_c, v_i + v_di, v_j + v_dj] * W[v_c, 0, v_di, v_dj]
